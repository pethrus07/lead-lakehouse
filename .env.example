# ── Banco de dados (Postgres via docker-compose) ────────────────────────────
LLH_DATABASE_URL=postgresql+psycopg://llh:llh@localhost:5433/leadlakehouse

# ── Tenant (single-tenant por enquanto; já preparado p/ multi-tenant) ───────
LLH_TENANT_ID=default

# ── Coleta / browser ────────────────────────────────────────────────────────
LLH_HEADLESS=true
LLH_CONCORRENCIA=4
LLH_DELAY_MIN_MS=800
LLH_DELAY_MAX_MS=2500
LLH_BRONZE_DIR=data/bronze

# ── Proxy (DESLIGADO por padrão — custo zero) ───────────────────────────────
LLH_PROXY_URL=

# ── Fontes/enriquecimento pagos (DESLIGADOS por padrão — custo zero) ────────
LLH_GOOGLE_PLACES_API_KEY=
LLH_PAGESPEED_API_KEY=

# ── Integração zapagente ────────────────────────────────────────────────────
# API na raiz (sem /api). Token JWT (validade 7 dias) OU use --email/--senha no CLI.
LLH_ZAPAGENTE_BASE_URL=http://localhost:3000
LLH_ZAPAGENTE_TOKEN=
